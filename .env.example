# ─────────────────────────────────────────────────────────────────────────────
# Infinigrow Hospital Cloud — environment template
#
# Copy to `.env` and fill in real values:  Copy-Item .env.example .env
#
# .env is git-ignored and MUST NEVER be committed. No real credential, connection
# string or key belongs in this file or in any file tracked by git.
#
# The API validates this configuration at startup and REFUSES to boot in
# production if a placeholder secret, a wildcard CORS origin or a non-HTTPS-safe
# setting is detected. See apps/api/src/config/env.ts
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development

PORT=4000
HOST=0.0.0.0

# ── Logging ──────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace | silent
# Production refuses to start on debug or trace.
LOG_LEVEL=info

# Pretty console output for local development. Keep false in production so logs
# stay machine-parseable JSON.
LOG_PRETTY=true


# ── HTTP / CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API.
# Production refuses "*" and any localhost origin.
CORS_ORIGINS=http://localhost:5173

# Request body size limit accepted by express.json().
REQUEST_BODY_LIMIT=1mb

# Only enable when a trusted reverse proxy / load balancer sets X-Forwarded-For.
# Leaving this false when a proxy IS present breaks correct client IPs.
# Leaving this true WITHOUT a proxy lets clients spoof their IP, which defeats
# IP-based rate limiting and poisons audit logs.
TRUST_PROXY=false
# Number of proxy hops to trust. Must be > 0 when TRUST_PROXY is true.
TRUST_PROXY_HOPS=0


# ── Database (MongoDB Atlas) ─────────────────────────────────────────────────
# Paste your Atlas SRV string here. Never commit it, never paste it into chat.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017

# Logical database name. Letters, digits, underscore and hyphen only.
MONGODB_DB_NAME=infinigrow

MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Leave false: index creation is handled by the migration runner so that index
# builds are explicit, backgrounded and verifiable. Enabling this makes Mongoose
# build indexes on boot, which can block on large collections.
MONGODB_AUTO_INDEX=false


# ── API documentation ────────────────────────────────────────────────────────
# Serves the OpenAPI explorer. Production refuses to start when this is true.
ENABLE_API_DOCS=true


# ─────────────────────────────────────────────────────────────────────────────
# Phase 1 — identity and tenancy (values defined when Phase 1 begins)
# ─────────────────────────────────────────────────────────────────────────────
# Ed25519 / RSA key pair used to sign access tokens. Generate and store in your
# platform's secret manager. Never commit key material.
#
# ⚠️ REQUIRED. These are deliberately left blank rather than commented out, because a
# commented-out key is the single most-missed value in this file: the API boots
# successfully and then fails EVERY authenticated request with "JWT signing keys are not
# configured", which reads as an authentication bug rather than a missing setting.
# `config/env.ts` does not check these at boot — `keysFromEnv` does, at first use.
#
#   node scripts/generate-jwt-keys.mjs
#
# Generate a SEPARATE pair per environment. Reuse means a staging compromise forges
# production tokens.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=https://api.infinigrow.example
JWT_AUDIENCE=infinigrow-web

# Pepper mixed into password hashing. Optional but recommended: a leaked
# database alone will then not permit offline password cracking.
# PASSWORD_PEPPER=

# ⚠️ Where generated PDFs are written. Read directly by
# `apps/api/src/modules/clinical/file-store.ts`.
#
# Unset defaults to `<cwd>/.private-storage`. Under systemd with `ProtectSystem=strict`
# that path is READ-ONLY, so the service starts cleanly and then fails the first invoice
# or prescription write with a permission error. Set it to a path the service owns, and
# give it a matching `ReadWritePaths`.
#
# The local-disk adapter is a DEVELOPMENT store: no redundancy, no versioning, no backup.
# For production, point this at private object storage — see docs/DEPLOYMENT.md section 5.2.
# CLINICAL_STORAGE_DIR=/var/lib/infinigrow/documents

# SMTP for password reset and staff invitations. Required in Phase 1.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=no-reply@infinigrow.example


# ─────────────────────────────────────────────────────────────────────────────
# Phase 1+ — private object storage (invoices, prescriptions, logos)
# ─────────────────────────────────────────────────────────────────────────────
# S3_ENDPOINT=
# S3_REGION=ap-south-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Presigned URL lifetime in seconds. Keep short — these grant access to records.
# S3_SIGNED_URL_TTL_SECONDS=300


# ─────────────────────────────────────────────────────────────────────────────
# Web application (Vite — only VITE_* variables reach the browser bundle)
# ─────────────────────────────────────────────────────────────────────────────
# VITE_API_BASE_URL=/api/v1
# VITE_DEV_API_PROXY=http://localhost:4000